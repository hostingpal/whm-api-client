{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hostingpal.github.io/whm-api-client/schema/toolchain-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest",
    "annotations",
    "overlay",
    "schema_dir",
    "map",
    "map_checksum",
    "examples"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "manifest": {
      "type": "string",
      "minLength": 1
    },
    "annotations": {
      "type": "string",
      "minLength": 1
    },
    "overlay": {
      "type": "string",
      "minLength": 1
    },
    "schema_dir": {
      "type": "string",
      "minLength": 1
    },
    "map": {
      "type": "string",
      "minLength": 1
    },
    "map_checksum": {
      "type": "string",
      "minLength": 1
    },
    "examples": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "schema"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "schema": {
            "enum": [
              "api-map-v1.schema.json",
              "capability-profile-v1.schema.json",
              "capability-report-v1.schema.json",
              "capability-explanations-v1.schema.json",
              "drift-report-v1.schema.json"
            ]
          }
        }
      }
    }
  }
}
