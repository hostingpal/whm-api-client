{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hostingpal.github.io/whm-api-client/schema/coverage-baseline-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "operations",
    "mappings"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "operations": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "mappings": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operation_id",
          "variant_id",
          "symbol",
          "status",
          "tests",
          "contract_units"
        ],
        "properties": {
          "operation_id": {
            "type": "string",
            "minLength": 1
          },
          "variant_id": {
            "type": "string",
            "minLength": 1
          },
          "symbol": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "implemented",
              "partial"
            ]
          },
          "tests": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "contract_units": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "hash",
                "tests"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "hash": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "tests": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "minItems": 1
                }
              }
            }
          }
        }
      }
    }
  }
}
