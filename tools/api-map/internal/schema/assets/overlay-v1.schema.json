{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hostingpal.github.io/whm-api-client/schema/overlay-v1.schema.json",
  "title": "Generated-client overlay group file v1",
  "type": "object",
  "properties": {
    "schema_version": {"const": "1.0"},
    "family": {"enum": ["uapi", "whm1"]},
    "group": {"type": "string", "minLength": 1},
    "accessor": {"type": "string", "pattern": "^[a-z][A-Za-z0-9]*$"},
    "class": {"type": "string", "pattern": "^[A-Z][A-Za-z0-9]*$"},
    "description": {"type": "string", "minLength": 1},
    "operations": {
      "type": "object",
      "propertyNames": {"pattern": "^(uapi|whm1):[A-Za-z0-9_/]+$"},
      "additionalProperties": {"$ref": "#/$defs/operation"}
    }
  },
  "required": ["schema_version", "family", "group", "operations"],
  "additionalProperties": false,
  "$defs": {
    "evidence": {
      "type": "object",
      "properties": {
        "kind": {"enum": ["doc", "live"]},
        "version": {"type": "string", "minLength": 1},
        "date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
        "note": {"type": "string", "minLength": 1},
        "fingerprint": {"type": "string", "minLength": 1},
        "source_sha256": {"type": "string", "minLength": 1},
        "pointer": {"type": "string", "pattern": "^/"}
      },
      "required": ["kind", "version", "date", "note"],
      "additionalProperties": false
    },
    "evidenceList": {"type": "array", "items": {"$ref": "#/$defs/evidence"}, "minItems": 1},
    "note": {
      "type": "object",
      "properties": {
        "kind": {"enum": ["documented", "observed", "policy"]},
        "text": {"type": "string", "minLength": 1}
      },
      "required": ["kind", "text"],
      "additionalProperties": false
    },
    "multipartUpload": {
      "type": "object",
      "properties": {
        "php": {"type": "string", "pattern": "^[a-z][A-Za-z0-9]*$"},
        "source": {"const": "file"},
        "text": {"const": "module"}
      },
      "required": ["php", "source", "text"],
      "additionalProperties": false
    },
    "multipartUploads": {
      "type": "object",
      "properties": {
        "php": {
          "type": "string",
          "pattern": "^[a-z][A-Za-z0-9]*$"
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "prefix": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"
        },
        "start": {
          "const": 0
        },
        "routes": {
          "const": "direct"
        },
        "filename_forbidden": {
          "const": "<>;"
        }
      },
      "required": [
        "php",
        "source",
        "prefix",
        "start",
        "routes",
        "filename_forbidden"
      ],
      "additionalProperties": false
    },
    "collection": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "indexed",
            "repeat",
            "map"
          ]
        },
        "item_type": {
          "enum": [
            "string",
            "int",
            "bool",
            "string|int"
          ]
        },
        "allow_scalar": {
          "type": "boolean"
        },
        "empty": {
          "enum": [
            "reject",
            "allow"
          ]
        },
        "prefix": {
          "type": "string",
          "pattern": "^([A-Za-z_][A-Za-z0-9_-]*)?$"
        },
        "separator": {
          "enum": [
            "",
            "-"
          ]
        },
        "start": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        }
      },
      "required": [
        "kind",
        "item_type",
        "allow_scalar",
        "empty"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "indexed"
              }
            }
          },
          "then": {
            "required": [
              "prefix",
              "separator",
              "start"
            ],
            "properties": {
              "prefix": {
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
              },
              "empty": {
                "const": "reject"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "repeat"
              }
            }
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "prefix"
                  ]
                },
                {
                  "required": [
                    "separator"
                  ]
                },
                {
                  "required": [
                    "start"
                  ]
                }
              ]
            },
            "properties": {
              "empty": {
                "const": "reject"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "map"
              }
            }
          },
          "then": {
            "required": [
              "prefix"
            ],
            "properties": {
              "allow_scalar": {
                "const": false
              }
            },
            "not": {
              "anyOf": [
                {
                  "required": [
                    "separator"
                  ]
                },
                {
                  "required": [
                    "start"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "param": {
      "type": "object",
      "properties": {
        "collection": {"$ref": "#/$defs/collection"},
        "php": {"type": "string", "pattern": "^[a-z][A-Za-z0-9]*$"},
        "wire": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
        "type": {"enum": ["string", "string|int", "string|int|float", "true"]},
        "description": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "encoding": {"enum": ["scalar", "bool", "repeat", "numbered", "suffix-numbered", "suffix-numbered-scalar"]},
        "sensitive": {"type": "boolean"},
        "omit": {"type": "boolean"},
        "omit_empty": {"const": true},
        "reject_empty": {"const": true},
        "required": {"type": "boolean"},
        "enum_doc": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "typeSpec": {
      "type": "object",
      "properties": {
        "type": {"enum": ["string", "int", "number", "bool", "flag", "mixed", "list", "map", "object", "union"]},
        "literal": {"type": "string"},
        "nullable": {"type": "boolean"},
        "accept_empty_array": {"type": "boolean"},
        "accept": {"type": "array", "items": {"enum": ["numeric-string", "integral-fixed-point-string", "string-flag", "int-flag", "bool", "empty-string"]}, "uniqueItems": true},
        "preserve": {"type": "boolean"},
        "items": {"$ref": "#/$defs/typeSpec"},
        "values": {"$ref": "#/$defs/typeSpec"},
        "fields": {"type": "object", "additionalProperties": {"$ref": "#/$defs/typeSpec"}},
        "required": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "anyOf": {"type": "array", "items": {"$ref": "#/$defs/typeSpec"}, "minItems": 1}
      },
      "required": ["type"],
      "additionalProperties": false,
      "allOf": [
        {"if": {"required": ["accept_empty_array"]}, "then": {"properties": {"type": {"const": "object"}}}},
        {"if": {"required": ["literal"]}, "then": {"properties": {"type": {"const": "string"}}}},
        {"if": {"properties": {"type": {"const": "list"}}}, "then": {"required": ["items"]}},
        {"if": {"properties": {"type": {"const": "map"}}}, "then": {"required": ["values"]}},
        {"if": {"properties": {"type": {"const": "union"}}}, "then": {"required": ["anyOf"]}},
        {"if": {"properties": {"type": {"const": "object"}}}, "then": {"required": ["fields"]}}
      ]
    },
    "correction": {
      "type": "object",
      "properties": {
        "type": {"enum": ["string", "int", "number", "bool", "flag", "mixed"]},
        "accept": {"type": "array", "items": {"enum": ["numeric-string", "integral-fixed-point-string", "string-flag", "int-flag", "bool", "empty-string"]}, "uniqueItems": true},
        "nullable": {"type": "boolean"},
        "accept_empty_array": {"type": "boolean"},
        "preserve": {"type": "boolean"},
        "required": {"type": "boolean"},
        "add": {"$ref": "#/$defs/typeSpec"},
        "replace": {"$ref": "#/$defs/typeSpec"},
        "evidence": {"$ref": "#/$defs/evidenceList"}
      },
      "required": ["evidence"],
      "additionalProperties": false
    },
    "inputCorrection": {
      "type": "object",
      "properties": {
        "required": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "nonempty": {
          "const": true
        },
        "evidence": {
          "$ref": "#/$defs/evidenceList"
        }
      },
      "required": [
        "evidence"
      ],
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "required"
          ]
        },
        {
          "required": [
            "nonempty"
          ]
        }
      ]
    },
    "jsonBody": {
      "type": "object",
      "properties": {
        "php": {
          "type": "string",
          "pattern": "^[a-z][A-Za-z0-9]*$"
        },
        "alias": {
          "type": "string",
          "pattern": "^[A-Z][A-Za-z0-9]*Input$"
        },
        "routes": {
          "const": "direct"
        },
        "required": {
          "type": "boolean"
        },
        "corrections": {
          "type": "object",
          "propertyNames": {
            "pattern": "^(/.*)?$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/inputCorrection"
          }
        }
      },
      "required": [
        "php",
        "alias",
        "routes"
      ],
      "additionalProperties": false
    },
    "multipartUploadFamily": {
      "type": "object",
      "properties": {
        "php": {
          "type": "string",
          "pattern": "^[a-z][A-Za-z0-9]*$"
        },
        "source": {
          "enum": [
            "file",
            "backup"
          ]
        },
        "routes": {
          "const": "direct"
        }
      },
      "required": [
        "php",
        "source",
        "routes"
      ],
      "additionalProperties": false
    },
    "operation": {
      "type": "object",
      "allOf": [
        {"not": {"required": ["multipart_upload", "multipart_uploads"]}},
        {"not": {"required": ["multipart_upload", "multipart_upload_family"]}},
        {"not": {"required": ["multipart_uploads", "multipart_upload_family"]}}
      ],
      "properties": {
        "multipart_upload_family": {"$ref": "#/$defs/multipartUploadFamily"},
        "multipart_upload": {"$ref": "#/$defs/multipartUpload"},
        "multipart_uploads": {"$ref": "#/$defs/multipartUploads"},
        "name": {"type": "string", "pattern": "^[a-z][A-Za-z0-9]*$"},
        "function": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*/[A-Za-z_][A-Za-z0-9_]*$"},
        "variant": {"enum": ["GET", "POST"]},
        "method": {"enum": ["GET", "POST"]},
        "body": {"enum": ["multipart", "json"]},
        "json_body": {"$ref": "#/$defs/jsonBody"},
        "body_fields": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "minLength": 1}},
        "outcome": {"enum": ["flag", "unchecked"]},
        "unwrap": {"type": "string", "minLength": 1},
        "void": {"type": "boolean"},
        "optional_payload": {"type": "boolean"},
        "order": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "params": {"type": "object", "additionalProperties": {"$ref": "#/$defs/param"}},
        "additional_methods": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/additionalMethod"}},
        "response": {"type": "object", "additionalProperties": {"$ref": "#/$defs/correction"}},
        "notes": {"type": "array", "items": {"$ref": "#/$defs/note"}},
        "exclude": {
          "type": "object",
          "properties": {
            "reason": {"type": "string", "minLength": 1},
            "evidence": {"$ref": "#/$defs/evidenceList"}
          },
          "required": ["reason", "evidence"],
          "additionalProperties": false
        },
        "probe": {"type": "object"},
        "evidence": {"$ref": "#/$defs/evidenceList"}
      },
      "additionalProperties": false
    },
    "additionalMethod": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "inputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/methodInput"
          }
        }
      },
      "required": [
        "name",
        "inputs"
      ],
      "additionalProperties": false
    },
    "methodInput": {
      "type": "object",
      "properties": {
        "php": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "records": {
          "$ref": "#/$defs/records"
        },
        "json": {
          "type": "object",
          "properties": {"alias": {"type": "string", "minLength": 1}},
          "required": ["alias"],
          "additionalProperties": false
        }
      },
      "required": [
        "php"
      ],
      "additionalProperties": false,
      "dependentRequired": {"json": ["source"]},
      "oneOf": [
        {
          "required": [
            "source"
          ],
          "not": {
            "required": [
              "records"
            ]
          }
        },
        {
          "required": [
            "records"
          ],
          "not": {
            "required": [
              "source"
            ]
          }
        }
      ]
    },
    "records": {
      "type": "object",
      "properties": {
        "alias": {
          "type": "string",
          "minLength": 1
        },
        "start": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "separator": {
          "enum": [
            "",
            "-"
          ]
        },
        "sensitive": {
          "type": "boolean"
        },
        "fields": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "source": {
                "type": "string",
                "minLength": 1
              },
              "php": {
                "type": "string",
                "minLength": 1
              },
              "prefix": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
              }
            },
            "required": [
              "source",
              "php",
              "prefix"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "alias",
        "start",
        "separator",
        "sensitive",
        "fields"
      ],
      "additionalProperties": false
    }
  }
}
