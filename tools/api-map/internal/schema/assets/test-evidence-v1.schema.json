{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hostingpal.github.io/whm-api-client/schema/test-evidence-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "runs"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "run_id",
          "revision",
          "completed_at",
          "command",
          "outcomes"
        ],
        "properties": {
          "run_id": {
            "type": "string",
            "minLength": 1
          },
          "revision": {
            "type": "string",
            "minLength": 1
          },
          "completed_at": {
            "type": "string",
            "format": "date-time"
          },
          "command": {
            "type": "string",
            "minLength": 1
          },
          "outcomes": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "symbol",
                "status"
              ],
              "properties": {
                "symbol": {
                  "type": "string",
                  "minLength": 1
                },
                "status": {
                  "enum": [
                    "passed",
                    "failed",
                    "skipped"
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}
